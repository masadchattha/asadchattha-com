---
// Shell for every Decorna page on this site, now and later. It carries the app's own look, not the
// portfolio's: Decorna's light and dark roles (the same values as `DecornaTheme` in the app), switched by the
// system setting. A new Decorna page uses this layout and inherits the theme; do not restyle it per page.

interface Props {
  title: string;
  description: string;
  /** Path only, with the trailing slash the site serves (e.g. '/decorna/privacy/'). */
  path: string;
}

const { title, description, path } = Astro.props;

const canonical = `https://asadchattha.com${path}`;
const pages = [
  { label: 'Privacy', href: '/decorna/privacy/' },
  { label: 'Terms', href: '/decorna/terms/' },
  { label: 'Support', href: '/decorna/support/' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F5F6FA" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111114" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="96x96" href="/decorna/icon-96.png" />
    <link rel="apple-touch-icon" href="/decorna/icon-180.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://asadchattha.com/decorna/icon-180.png" />
  </head>
  <body>
    <div class="page">
      <header class="brand">
        <img src="/decorna/icon-96.png" width="44" height="44" alt="" />
        <span>Decorna</span>
      </header>

      <main id="content" class="card">
        <slot />
      </main>

      <footer>
        <nav aria-label="Decorna pages">
          {pages.map((p) => (
            <a href={p.href} aria-current={p.href === path ? 'page' : undefined}>{p.label}</a>
          ))}
        </nav>
        <p>Decorna is made by Muhammad Asad.</p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  /* Roles mirror DecornaTheme: background, surface, border, text*, accent, accentSoft. `link` is a lighter
     accent in dark mode only, because the app's blue is too dim for text on a near-black page. */
  :root {
    --background: #F5F6FA;
    --surface: #FFFFFF;
    --border: #E3E5EA;
    --text-primary: #111113;
    --text-secondary: #5E5F66;
    --text-tertiary: #9A9CA5;
    --accent: #1A40FF;
    --accent-soft: #D9E0FF;
    --link: #1A40FF;
    --shadow: rgba(17, 17, 19, 0.06);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --background: #111114;
      --surface: #1A1D24;
      --border: #2C303A;
      --text-primary: #EDEEF0;
      --text-secondary: #9CA3AF;
      --text-tertiary: #6B7280;
      --accent-soft: #27334E;
      --link: #8AA0FF;
      --shadow: rgba(0, 0, 0, 0.4);
    }
  }

  * { box-sizing: border-box; }

  html { -webkit-text-size-adjust: 100%; }

  body {
    margin: 0;
    background: var(--background);
    color: var(--text-secondary);
    font: 16px/1.65 -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: max(24px, env(safe-area-inset-top)) 16px max(32px, env(safe-area-inset-bottom));
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 4px 20px;
    color: var(--text-primary);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .brand img { border-radius: 10px; }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: 0 4px 16px var(--shadow);
    padding: 28px 24px 12px;
  }

  @media (min-width: 640px) {
    .card { padding: 40px 44px 20px; }
  }

  .card h1 {
    margin: 0;
    color: var(--text-primary);
    font-size: 30px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .card .meta {
    margin: 8px 0 0;
    color: var(--text-tertiary);
    font-size: 14px;
  }

  .card .intro {
    margin: 24px 0 0;
    padding: 16px 18px;
    background: var(--accent-soft);
    border-radius: 12px;
    color: var(--text-primary);
    font-size: 16px;
  }

  .card section { margin-top: 32px; padding-top: 28px; border-top: 1px solid var(--border); }

  .card h2 {
    margin: 0;
    color: var(--text-primary);
    font-size: 19px;
    line-height: 1.3;
    font-weight: 650;
  }

  .card section p { margin: 14px 0 0; }
  .card section:last-child { padding-bottom: 20px; }

  .card strong { color: var(--text-primary); font-weight: 600; }

  a { color: var(--link); text-underline-offset: 3px; }
  a:hover { text-decoration-thickness: 2px; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }

  footer { padding: 24px 4px 0; font-size: 14px; color: var(--text-tertiary); }
  footer nav { display: flex; flex-wrap: wrap; gap: 4px 20px; }
  footer nav a { font-weight: 600; text-decoration: none; }
  footer nav a[aria-current='page'] { color: var(--text-primary); }
  footer p { margin: 12px 0 0; }
</style>
