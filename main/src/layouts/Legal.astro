---
// Body of a Decorna legal or support page: title, date line, a one-sentence summary, then headed sections.
// The theme and page chrome come from `Decorna.astro`.
import Decorna from './Decorna.astro';

interface Section { heading: string; body: string[] }

interface Props {
  title: string;
  description: string;
  /** Path only, with the trailing slash the site serves (e.g. '/decorna/privacy/'). */
  path: string;
  h1: string;
  /** One line under the title, e.g. "Last updated 11 October 2026". */
  meta: string;
  intro: string;
  sections: Section[];
}

const { title, description, path, h1, meta, intro, sections } = Astro.props;
---

<Decorna title={title} description={description} path={path}>
  <h1>{h1}</h1>
  <p class="meta">{meta}</p>
  <p class="intro" set:html={intro} />

  {sections.map((s) => (
    <section>
      <h2>{s.heading}</h2>
      {s.body.map((p) => <p set:html={p} />)}
    </section>
  ))}
</Decorna>
